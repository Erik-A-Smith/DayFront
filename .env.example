# Container/system timezone used for logs and runtime behavior.
TZ=UTC

# Calendar display timezone: local, UTC, or an IANA timezone.
DAYFRONT_CALENDAR_TIMEZONE=local

# Optional multi-user login. The secret must be unique, high-entropy, stable,
# and at least 32 characters. Leave these unset for legacy single-user mode.
# DAYFRONT_AUTH_MODE=caldav-login
# DAYFRONT_AUTH_SESSION_SECRET=replace-with-a-long-random-deployment-secret
# Alternatively, point to a writable persistent file that DayFront may create.
# DAYFRONT_AUTH_SESSION_SECRET_FILE=/data/session-secret
# DAYFRONT_AUTH_SESSION_TTL_HOURS=720
