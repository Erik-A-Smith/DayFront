{
  "name": "@dayfront/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "DAYFRONT_CONFIG_FILE=${DAYFRONT_CONFIG_FILE:-../../config.example.yaml} tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "DAYFRONT_INTEGRATION_TEST=true vitest run test/caldav.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dayfront/shared": "workspace:*",
    "express": "5.2.1",
    "fast-xml-parser": "^5.10.1",
    "ical.js": "^2.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
